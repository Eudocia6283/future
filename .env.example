# Gemini API key. Leave empty to run the book in mock mode with a scripted reading.
GEMINI_API_KEY=""
# Model id; any Gemini model that supports JSON output works.
GEMINI_MODEL="gemini-flash-latest"
# Optional: a relay endpoint in place of generativelanguage.googleapis.com.
GEMINI_BASE_URL=""
# Optional: an HTTP proxy for reaching the Gemini API, e.g. http://127.0.0.1:7890
HTTPS_PROXY=""
